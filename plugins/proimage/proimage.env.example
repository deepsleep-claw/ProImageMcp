# Copy this file to the config path reported by proimage_get_presets.
PROIMAGE_PRESETS=OPENROUTER_IMAGE2_HIGH
PROIMAGE_DEFAULT_PRESET=OPENROUTER_IMAGE2_HIGH

PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_DISPLAY_NAME=OpenRouter GPT-Image-2 High
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_ADAPTER=openrouter-images
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_API_KEY=replace-with-your-openrouter-key
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_BASE_URL=https://openrouter.ai/api/v1/images
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_MODEL=openai/gpt-image-2
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_CAPABILITIES=text_to_image,image_to_image,transparent
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_DESCRIPTION=OpenRouter GPT-Image-2，默认 high 质量；透明背景请求会原样传递。
PROIMAGE_PRESET_OPENROUTER_IMAGE2_HIGH_OPTIONS_JSON={"quality":"high","output_format":"png"}

# Global settings (optional)
# PROIMAGE_OUTPUT_DIR=/absolute/path/to/ProImage
# PROIMAGE_TIMEOUT_MS=900000
# PROIMAGE_CONNECT_TIMEOUT_MS=30000
# PROIMAGE_MAX_INPUT_BYTES=52428800
# PROIMAGE_MAX_TOTAL_INPUT_BYTES=209715200
# PROIMAGE_MAX_OUTPUT_BYTES=104857600
# PROIMAGE_LOG_RETENTION_DAYS=30
